    {
      "fieldName": "成品文件",
      "fieldId": "fldNphxLbE",
      "type": "attachment",
      "required": true,
      "enumValues": [],
      "description": "必填，图片或视频附件，识别关键词：成品、图片、视频、封面、成片文件"
    },
    {
      "fieldName": "核心数据",
      "fieldId": "fldYVKIa4D",
      "type": "text",
      "required": false,
      "enumValues": [],
      "description": "可选，文本形式的数据汇总，识别关键词：数据、播放量、点赞、评论、收藏、转化、效果"
    },
    {
      "fieldName": "实际发布时间",
      "fieldId": "fldfT4Gw22",
      "type": "datetime",
      "required": false,
      "enumValues": [],
