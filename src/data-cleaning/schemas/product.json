{
  "tableId": "tbljPr2PuZLFhSaI",
  "tableName": "成品发布与运营数据表",
  "primaryKey": {
    "fieldId": "fldhCxTtoc",
    "fieldName": "成品 ID",
    "format": "CP + 日期 + 3位递增"
  },
  "fields": [
    {
      "fieldName": "成品 ID",
      "fieldId": "fldhCxTtoc",
      "type": "auto_number",
      "required": true,
      "enumValues": [],
