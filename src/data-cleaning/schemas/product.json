    {
      "fieldName": "数据抓取时间",
      "fieldId": "flduC5yaZH",
      "type": "datetime",
      "required": false,
      "enumValues": [],
      "description": "可选，YYYY-MM-DD，识别关键词：抓取时间、数据更新时间、何时查看的数据"
