NODE_ENV=development
PORT=8787
LOG_LEVEL=info

COLLATOR_WEBHOOK_SECRET=replace_me
AUTO_COMMIT_ENABLED=false
DRY_RUN=true

DIFY_BASE_URL=https://your-dify.example.com
DIFY_WORKFLOW_API_KEY=replace_me
DIFY_WORKFLOW_ID=replace_me

FEISHU_APP_ID=replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_BASE_APP_TOKEN=replace_me
FEISHU_INGESTION_TABLE_ID=replace_me
FEISHU_REVIEW_TABLE_ID=replace_me
FEISHU_WRITE_LOG_TABLE_ID=replace_me
FEISHU_CUSTOMER_TABLE_ID=replace_me

# TASK_REPOSITORY: memory | feishu (default: memory)
# When feishu, all FEISHU_* credentials above must be set or startup fails.
TASK_REPOSITORY=memory

# Feishu write gate defaults are intentionally fail-closed.
# FEISHU_WRITE_ENV accepts only test or production-pilot; generic production
# never opens this path.
ENABLE_REAL_FEISHU_WRITE=false
FEISHU_WRITE_ENV=
FEISHU_TEST_BASE_APP_TOKEN=
FEISHU_TEST_TABLE_IDS=

# Controlled production pilot: bind a single run and exact allow-listed tables
# only after a separately reviewed preview. Notifications stay disabled.
ENABLE_PRODUCTION_PILOT=false
PRODUCTION_PILOT_MAX_RECORDS=0
PRODUCTION_PILOT_RUN_ID=
# Optional built-in HS256 JWT principal boundary. Keep empty when the host
# injects an OAuth/JWT or trusted reverse-proxy resolver through buildApp().
PRODUCTION_PILOT_JWT_SECRET=
FEISHU_PRODUCTION_PILOT_BASE_APP_TOKEN=
FEISHU_PRODUCTION_PILOT_TABLE_IDS=
ENABLE_PRODUCTION_PILOT_NOTIFICATIONS=false

DEFAULT_TIMEZONE=Asia/Shanghai
